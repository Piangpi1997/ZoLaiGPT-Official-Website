# Security headers for all static website assets.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Long-lived caching for immutable fonts and brand images.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/brand/*
  Cache-Control: public, max-age=2592000
/chat/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Keep Pages aliases and branch/deployment snapshots out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Draft legal documents and local chat demos are not indexed.
/privacy-policy*
  X-Robots-Tag: noindex, nofollow

/privacy-bm*
  X-Robots-Tag: noindex, nofollow

/terms-of-use*
  X-Robots-Tag: noindex, nofollow

/chat*
  X-Robots-Tag: noindex, nofollow

/qa*
  X-Robots-Tag: noindex, nofollow

/docs/*
  X-Robots-Tag: noindex, nofollow

/tools/*
  X-Robots-Tag: noindex, nofollow

# Source files published alongside the static output are not pages.
/src/*
  X-Robots-Tag: noindex, nofollow
/content/*
  X-Robots-Tag: noindex, nofollow
/scripts/*
  X-Robots-Tag: noindex, nofollow
/chat-workspace/*
  X-Robots-Tag: noindex, nofollow

/*.md
  X-Robots-Tag: noindex, nofollow
